{
  "name": "falconsync",
  "private": true,
  "scripts": {
    "test:backend": "npm --prefix falcon-sync-backend test",
    "test:frontend": "npm --prefix falcon-sync-frontend run test -- --watch=false",
    "seed:sync": "npm --prefix falcon-sync-backend run seed:sync",
    "seed:verify": "npm --prefix falcon-sync-backend run seed:verify",
    "build": "npm --prefix falcon-sync-frontend run build",
    "e2e": "npm --prefix falcon-sync-frontend run e2e",
    "verify": "npm run test:backend && npm run test:frontend && npm run build && npm run e2e"
  }
}
