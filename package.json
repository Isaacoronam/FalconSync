{
  "name": "falconsync",
  "private": true,
  "scripts": {
    "test:backend": "npm --prefix projects/backend test",
    "test:frontend": "npm --prefix projects/frontend run test -- --watch=false",
    "seed:sync": "npm --prefix projects/backend run seed:sync",
    "seed:verify": "npm --prefix projects/backend run seed:verify",
    "publish:pois": "npm --prefix projects/backend run publish:pois",
    "qr:generate": "npm --prefix projects/backend run qr:generate",
    "seed:adventures": "npm --prefix projects/backend run seed:adventures",
    "seed:adventures:verify": "npm --prefix projects/backend run seed:adventures:verify",
    "backfill:usernames": "npm --prefix projects/backend run backfill:usernames",
    "backfill:achievements": "npm --prefix projects/backend run backfill:achievements",
    "build": "npm --prefix projects/frontend run build",
    "e2e": "npm --prefix projects/frontend run e2e",
    "verify": "npm run test:backend && npm run test:frontend && npm run build && npm run e2e"
  }
}
