NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/falconsync
CORS_ORIGIN=http://localhost:4200
TRUST_PROXY=false

# Genera secretos propios de al menos 32 caracteres. No reutilices estos valores.
JWT_ACCESS_SECRET=genera-un-secreto-de-acceso-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=genera-un-secreto-de-refresco-distinto-de-al-menos-32-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
REFRESH_COOKIE_NAME=falconsync_refresh
COOKIE_SECURE=false

# Almacenamiento local de imágenes. La carpeta debe estar fuera del control de versiones.
UPLOAD_DIR=./uploads/images
# Avatares y fotos privadas de check-in, servidos solo por endpoints autenticados.
UPLOAD_PRIVATE_DIR=./uploads/documents
UPLOAD_MAX_IMAGE_BYTES=5242880

# Evidencia privada de conservación. En producción la carga permanece desactivada
# hasta desplegar un motor antimalware; el estado no escaneado solo se admite en
# desarrollo y pruebas.
EVIDENCE_MAX_BYTES=10485760
EVIDENCE_RETENTION_DAYS=365

# Los asistentes permanecen cerrados hasta publicar y evaluar el corpus dorado.
RAG_TOURIST_ENABLED=false
RAG_TECHNICAL_ENABLED=false
RAG_CORPUS_VERSION=
RAG_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DTYPE=q8
RAG_EMBEDDING_CACHE_DIR=
RAG_EMBEDDING_ALLOW_REMOTE=true
RAG_MIN_SIMILARITY=0.6

# Canal de Telegram. En v1 se recomienda polling: no necesita URL pública ni
# secreto de webhook. El token lo entrega @BotFather y nunca se versiona.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# URL pública de la SPA para los enlaces del bot. En producción debe ser HTTPS.
TELEGRAM_WEB_URL=http://localhost:4200
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PORT=3201
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_LINK_CODE_TTL_MINUTES=10
TELEGRAM_MAX_QUERIES_PER_HOUR=20
TELEGRAM_MAX_REPORTS_PER_DAY=3

# Solo los usa scripts/createAdmin.js. No los necesita la API en ejecución.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia-esta-clave-de-al-menos-12-caracteres
ADMIN_NAME=Administrador FalconSync
