{
  "name": "falcon-sync-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST de FalconSync para el patrimonio de Coro",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seedLocations.js",
    "seed:sync": "node scripts/seedLocations.js --sync",
    "seed:verify": "node scripts/seedLocations.js --verify",
    "publish:pois": "node scripts/publishLocations.js",
    "qr:generate": "node scripts/generateCheckInQr.js",
    "create-admin": "node scripts/createAdmin.js",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --test --watch --test-concurrency=1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
