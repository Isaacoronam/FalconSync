NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/falconsync
CORS_ORIGIN=http://localhost:4200
TRUST_PROXY=false

# Genera secretos propios de al menos 32 caracteres. No reutilices estos valores.
JWT_ACCESS_SECRET=genera-un-secreto-de-acceso-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=genera-un-secreto-de-refresco-distinto-de-al-menos-32-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
REFRESH_COOKIE_NAME=falconsync_refresh
COOKIE_SECURE=false

# Almacenamiento local de imágenes. La carpeta debe estar fuera del control de versiones.
UPLOAD_DIR=./uploads
UPLOAD_MAX_IMAGE_BYTES=5242880

# Solo los usa scripts/createAdmin.js. No los necesita la API en ejecución.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia-esta-clave-de-al-menos-12-caracteres
ADMIN_NAME=Administrador FalconSync
