# QR de check-in generados localmente (contienen tokens)
projects/backend/assets/qr-codes/

# Logs de ejecución del backend (PM2 y otros)
projects/backend/logs/*
!projects/backend/logs/.gitkeep

# Logs y archivos del sistema
*.log
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
